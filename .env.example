# Server
SERVER_PORT=8080

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gita_mentor
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_USE_SSL=false
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# Optional: override the full datasource URL instead of using MYSQL_* values.
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/gita_mentor?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=false

# Persistence
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Frontend CORS origins. Remove "null" in production unless you intentionally open HTML files from disk.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,null
